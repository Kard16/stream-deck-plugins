    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" PermissionRequest",
            "async": true,
            "timeout": 10
          },
          {
            "type": "http",
            "url": "http://127.0.0.1:47600/permission",
            "timeout": 600,
            "headers": {
              "Authorization": "Bearer $DECK_TOKEN"
            },
            "allowedEnvVars": [
              "DECK_TOKEN"
            ]
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/permission.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
