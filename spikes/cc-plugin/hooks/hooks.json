{
  "description": "deck-spike: an async logger on each of this build's 33 classic hook events, two PermissionRequest hooks that can decide (http and command), and the mod in register.ts.",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hook.sh\" ConfigChange",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "CwdChanged": [
