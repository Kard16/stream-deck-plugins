{
  "name": "smoke",
  "about": "Live check of DeckBridge in the test catalog (verification ladder step 4). Writes only to the test catalog, with exactly one photo selected, and leaves the photo as it found it: Exposure, flag, photo, view and module.",
  "catalog": "/Users/karimdhanji/Pictures/Plugin Test/Plugin Test.lrcat",
  "timeoutMs": 3000,
  "steps": [
    {"log": "hello: the test catalog must be open, so writes go through"},
    {"send": {"t": "hello", "v": 1, "client": "fake-deck", "ver": "0.1.0"}},
    {"expect": {"t": "hello", "v": 1, "writable": true}, "save": {"inst": "inst"},
     "hint": "writable must be true: open /Users/karimdhanji/Pictures/Plugin Test/Plugin Test.lrcat in Lightroom"},
    {"expect": {"t": "state", "photo": {"$type": "string"}, "sel": 1}, "save": {"photo0": "photo", "file0": "file", "flag0": "flag", "module0": "module"},
     "hint": "select exactly one photo in the test catalog, not the last one in the filmstrip. With Auto Sync on, Lightroom copies a dial edit to every selected photo"},
    {"log": "photo $photo0 ($file0), flag $flag0, in $module0"},

    {"log": "Develop, then watch the 13 bank params"},
    {"send": {"t": "module", "v": "develop"}},
    {"expect": {"t": "state", "module": "develop", "photo": "$photo0"}, "timeout": 6000},
    {"send": {"t": "watch", "ps": ["Temperature", "Tint", "Exposure", "Contrast", "Highlights", "Shadows", "Whites", "Blacks", "Texture", "Clarity", "Vibrance", "Saturation", "PostCropVignetteAmount"]}},
    {"expect": {"t": "ranges", "ranges": {
      "Temperature": "*", "Tint": "*", "Exposure": [-5, 5], "Contrast": [-100, 100],
      "Highlights": [-100, 100], "Shadows": [-100, 100], "Whites": [-100, 100], "Blacks": [-100, 100],
      "Texture": [-100, 100], "Clarity": [-100, 100], "Vibrance": [-100, 100], "Saturation": [-100, 100],
      "PostCropVignetteAmount": [-100, 100]}}},
    {"expect": {"t": "vals", "vals": {
      "Temperature": {"$type": "number"}, "Tint": {"$type": "number"}, "Exposure": {"$type": "number"}, "Contrast": {"$type": "number"},
      "Highlights": {"$type": "number"}, "Shadows": {"$type": "number"}, "Whites": {"$type": "number"}, "Blacks": {"$type": "number"},
      "Texture": {"$type": "number"}, "Clarity": {"$type": "number"}, "Vibrance": {"$type": "number"}, "Saturation": {"$type": "number"},
      "PostCropVignetteAmount": {"$type": "number"}}}, "save": {"exp0": "vals.Exposure"}},

    {"log": "one Exposure gesture: +0.1 and back, then done (Exposure starts at $exp0)"},
    {"let": {"exp1": {"$if": [{"$gt": ["$exp0", 4.85]}, {"$round": [{"$add": ["$exp0", -0.1]}, 2]}, {"$round": [{"$add": ["$exp0", 0.1]}, 2]}]}, "expDirty": true}},
    {"send": {"t": "set", "p": "Exposure", "v": "$exp1", "g": 1}},
    {"expect": {"t": "ack", "p": "Exposure", "v": "$exp1", "g": 1}},
    {"never": {"t": "vals", "vals": {"Exposure": "*"}}},
    {"wait": 150},
    {"send": {"t": "set", "p": "Exposure", "v": "$exp0", "g": 1}},
    {"expect": {"t": "ack", "p": "Exposure", "v": "$exp0", "g": 1}},
    {"let": {"expDirty": false}},
    {"send": {"t": "done", "g": 1}},
    {"drain": 400},

    {"log": "nav next, then prev"},
    {"send": {"t": "nav", "v": "next"}},
    {"expect": {"t": "state", "photo": {"$not": "$photo0"}}, "save": {"photo1": "photo"},
     "hint": "nav next didn't move: is $photo0 the last photo in the filmstrip? Select another one and run again"},
    {"send": {"t": "nav", "v": "prev"}},
    {"expect": {"t": "state", "photo": "$photo0"}, "hint": "nav prev didn't come back from $photo1 to $photo0"},
    {"drain": 300},

    {"log": "view before, then after"},
    {"let": {"viewDirty": true}},
    {"send": {"t": "view", "v": "before"}},
    {"wait": 600},
    {"send": {"t": "view", "v": "after"}},
    {"let": {"viewDirty": false}},
    {"drain": 300},

    {"log": "presets"},
    {"send": {"t": "presets", "id": 41}},
    {"expect": {"t": "presets", "id": 41, "items": {"$type": "array"}}},

    {"log": "flag pick, then none, on $photo0; then its own flag ($flag0) again. After each, 500 ms to see that Lightroom stayed on $photo0"},
    {"let": {"flagDirty": true}},
    {"send": {"t": "flag", "v": "pick"}},
    {"expect": {"t": "state", "photo": "$photo0", "flag": 1}, "hint": "if the photo changed, Lightroom's own Auto Advance is on: turn it off (Photo > Auto Advance)"},
    {"never": {"t": "state", "photo": {"$not": "$photo0"}}},
    {"drain": 500, "hint": "Lightroom moved on to $state.photo after the flag: its own Auto Advance is on. Turn it off (Photo > Auto Advance) and run again"},
    {"send": {"t": "flag", "v": "none"}},
    {"expect": {"t": "state", "photo": "$photo0", "flag": 0}},
    {"never": {"t": "state", "photo": {"$not": "$photo0"}}},
    {"drain": 500, "hint": "Lightroom moved on to $state.photo after the flag: its own Auto Advance is on. Turn it off (Photo > Auto Advance) and run again"},
    {"when": {"$ne": ["$flag0", 0]}, "send": {"t": "flag", "v": {"$map": ["$flag0", {"1": "pick", "-1": "reject"}]}}},
    {"when": {"$ne": ["$flag0", 0]}, "expect": {"t": "state", "photo": "$photo0", "flag": "$flag0"}},
    {"when": {"$ne": ["$flag0", 0]}, "never": {"t": "state", "photo": {"$not": "$photo0"}}},
    {"when": {"$ne": ["$flag0", 0]}, "drain": 500, "hint": "Lightroom moved on to $state.photo after the flag: its own Auto Advance is on. Turn it off (Photo > Auto Advance) and run again"},
    {"let": {"flagDirty": false}},

    {"log": "ping"},
    {"send": {"t": "ping", "id": 42}},
    {"expect": {"t": "pong", "id": 42, "lt": {"$type": "number"}}},
    {"drain": 300}
  ],
  "cleanup": [
    {"note": "Runs even after a failure. Writes only while Lightroom is back on the starting photo, and the fake deck refuses writes outside the test catalog."},
    {"let": {"onPhoto1": {"$and": ["$photo1", {"$eq": ["$state.photo", "$photo1"]}]}}},
    {"when": "$onPhoto1", "log": "going back from $photo1 to $photo0 with nav prev"},
    {"when": "$onPhoto1", "send": {"t": "nav", "v": "prev"}},
    {"when": "$onPhoto1", "expect": {"t": "state", "photo": "$photo0"}},
    {"let": {"onPhoto0": {"$eq": ["$state.photo", "$photo0"]}}},
    {"let": {"fixExp": {"$and": ["$expDirty", "$onPhoto0"]}, "fixFlag": {"$and": ["$flagDirty", "$onPhoto0"]}}},
    {"when": {"$and": [{"$or": ["$expDirty", "$flagDirty"]}, {"$ne": ["$onPhoto0", true]}]},
     "fail": "can't put $photo0 back: Lightroom is on $state.photo now. Put back Exposure $exp0 and flag $flag0 by hand"},
    {"when": "$fixExp", "log": "putting Exposure back to $exp0"},
    {"when": "$fixExp", "send": {"t": "set", "p": "Exposure", "v": "$exp0", "g": 99}},
    {"when": "$fixExp", "expect": {"t": "ack", "p": "Exposure", "v": "$exp0", "g": 99}},
    {"when": "$fixExp", "send": {"t": "done", "g": 99}},
    {"when": "$fixFlag", "log": "putting the flag of $photo0 back to $flag0"},
    {"when": "$fixFlag", "send": {"t": "flag", "v": {"$map": ["$flag0", {"1": "pick", "0": "none", "-1": "reject"}]}}},
    {"when": "$fixFlag", "expect": {"t": "state", "photo": "$photo0", "flag": "$flag0"}},
    {"when": "$fixFlag", "wait": 500, "note": "Lightroom's own Auto Advance, if it's on, moves on after this flag too"},
    {"let": {"advanced": {"$and": ["$fixFlag", "$photo1", {"$eq": ["$state.photo", "$photo1"]}]}}},
    {"when": "$advanced", "log": "Auto Advance moved on to $photo1 after the flag: back to $photo0 with nav prev"},
    {"when": "$advanced", "send": {"t": "nav", "v": "prev"}},
    {"when": "$advanced", "expect": {"t": "state", "photo": "$photo0"}},
    {"when": "$viewDirty", "send": {"t": "view", "v": "after"}},
    {"when": {"$eq": ["$module0", "library"]}, "log": "back to Library, where it started"},
    {"when": {"$eq": ["$module0", "library"]}, "send": {"t": "module", "v": "library"}},
    {"when": {"$eq": ["$module0", "library"]}, "expect": {"t": "state", "module": "library"}, "timeout": 6000},
    {"drain": 300}
  ]
}
